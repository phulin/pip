{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pip-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "8f088d4bd190caf693cc42bb8311fd7d",
  "workers_dev": false,
  "routes": [{"pattern": "api.mypip.baby", "custom_domain": true}],
  "limits": {"cpu_ms": 5000},
  "observability": {"enabled": true},
  "d1_databases": [{"binding": "DB", "database_name": "pip-db", "database_id": "f7277949-c946-4cae-9fdf-19fc0285f784", "migrations_dir": "migrations"}],
  "ratelimits": [{"name": "AUTH_LIMITER", "namespace_id": "71001", "simple": {"limit": 10, "period": 60}}],
  "triggers": {"crons": ["17 3 * * *"]}
}
