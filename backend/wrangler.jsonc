{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pip-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {"enabled": true},
  "d1_databases": [{"binding": "DB", "database_name": "pip-db", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations"}],
  "ratelimits": [{"name": "AUTH_LIMITER", "namespace_id": "71001", "simple": {"limit": 10, "period": 60}}],
  "triggers": {"crons": ["17 3 * * *"]}
}
